# Copy file nay thanh keystore.properties (da gitignore) de tranh dat mat khau trong code.
# Hoac dat bien moi truong: GUARD_STORE_PASSWORD, GUARD_KEY_ALIAS, GUARD_KEY_PASSWORD.
# Neu bo trong, build se dung gia tri mac dinh cu (guardpass / guard) de tuong thich ban dang cai.
storeFile=guard.keystore
storePassword=
keyAlias=guard
keyPassword=
